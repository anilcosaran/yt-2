# yt-2 runs fully offline on mock data (see mock/README.md); no variable is required.

# Simulated API latency in milliseconds (mutations wait twice as long). 0 = instant.
NEXT_PUBLIC_MOCK_LATENCY_MS=120

# Screens that are switched on by default in yt-2; set to "false" to hide them.
MOTION_UI_ENABLED=true
SPARK_EXPORT_ENABLED=true
