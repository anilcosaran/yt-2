{
  "description": "Y1-07 W4 parity cases for resolved scene timing. The same file (copy guarded by a digest in both tests) is read by youtorch-ui/lib/spark/scene-timing.test.ts and api-gateway/tests/unit/composition/scene-preview-timing.test.ts. Lengths are frames; null = unresolved; an unresolved scene counts 0 for the start of the scenes after it.",
  "cases": [
    {
      "name": "fixed scenes play back to back",
      "canvas_fps": { "num": 30, "den": 1 },
      "scene_sequence": ["s1", "s2"],
      "scenes": [
        { "scene_id": "s1", "timing_policy": "fixed", "duration_frames": 90, "layers": [] },
        { "scene_id": "s2", "timing_policy": "fixed", "duration_frames": 45, "layers": [] }
      ],
      "audio_placements": [],
      "expected": { "scenes": [["s1", 0, 90], ["s2", 90, 45]], "total_frames": 135 }
    },
    {
      "name": "follow_media is the latest clip scene_range end",
      "canvas_fps": { "num": 30, "den": 1 },
      "scene_sequence": ["s1"],
      "scenes": [
        {
          "scene_id": "s1",
          "timing_policy": "follow_media",
          "layers": [
            { "layer_id": "l1", "layer_kind": "clip", "placement": { "source_id": "a", "scene_range": { "start_frame": 0, "end_frame": 60 } } },
            { "layer_id": "l2", "layer_kind": "clip", "placement": { "source_id": "b", "scene_range": { "start_frame": 30, "end_frame": 120 } } },
            { "layer_id": "l3", "layer_kind": "text", "text": "x", "scene_range": { "start_frame": 0, "end_frame": 300 } }
          ]
        }
      ],
      "audio_placements": [],
      "expected": { "scenes": [["s1", 0, 120]], "total_frames": 120 }
    },
    {
      "name": "follow_media ignores global clip spans and invalid ranges",
      "canvas_fps": { "num": 30, "den": 1 },
      "scene_sequence": ["s1", "s2"],
      "scenes": [
        {
          "scene_id": "s1",
          "timing_policy": "follow_media",
          "layers": [
            { "layer_id": "l1", "layer_kind": "clip", "placement": { "source_id": "a", "project_range": { "start_frame": 0, "end_frame": 90 } } },
            { "layer_id": "l2", "layer_kind": "clip", "placement": { "source_id": "b", "scene_range": { "start_frame": 10, "end_frame": 10 } } }
          ]
        },
        { "scene_id": "s2", "timing_policy": "fixed", "duration_frames": 30, "layers": [] }
      ],
      "audio_placements": [],
      "expected": { "scenes": [["s1", 0, null], ["s2", 0, 30]], "total_frames": 30 }
    },
    {
      "name": "follow_narration is the scene's narration end",
      "canvas_fps": { "num": 24, "den": 1 },
      "scene_sequence": ["s1", "s2", "s3"],
      "scenes": [
        { "scene_id": "s1", "timing_policy": "follow_narration", "layers": [] },
        { "scene_id": "s2", "timing_policy": "follow_narration", "layers": [] },
        { "scene_id": "s3", "timing_policy": "follow_narration", "layers": [] }
      ],
      "audio_placements": [
        { "placement_id": "p1", "role": "narration", "scene_id": "s1", "scene_range": { "start_frame": 0, "end_frame": 200 } },
        { "placement_id": "p2", "role": "narration", "scene_id": "s1", "scene_range": { "start_frame": 0, "end_frame": 240 } },
        { "placement_id": "p3", "role": "music", "scene_id": "s2", "scene_range": { "start_frame": 0, "end_frame": 500 } },
        { "placement_id": "p4", "role": "narration", "scene_id": "s3", "project_range": { "start_frame": 0, "end_frame": 100 } }
      ],
      "expected": { "scenes": [["s1", 0, 240], ["s2", 240, null], ["s3", 240, null]], "total_frames": 240 }
    },
    {
      "name": "sequence order wins, unknown ids are skipped, bad fixed durations are unresolved",
      "canvas_fps": { "num": 30000, "den": 1001 },
      "scene_sequence": ["b", "ghost", "a", "c", "d"],
      "scenes": [
        { "scene_id": "a", "timing_policy": "fixed", "duration_frames": 10, "layers": [] },
        { "scene_id": "b", "timing_policy": "fixed", "duration_frames": 20, "layers": [] },
        { "scene_id": "c", "timing_policy": "fixed", "layers": [] },
        { "scene_id": "d", "timing_policy": "fixed", "duration_frames": 0, "layers": [] }
      ],
      "audio_placements": [],
      "expected": { "scenes": [["b", 0, 20], ["a", 20, 10], ["c", 30, null], ["d", 30, null]], "total_frames": 30 }
    },
    {
      "name": "empty sequence",
      "canvas_fps": { "num": 30, "den": 1 },
      "scene_sequence": [],
      "scenes": [],
      "audio_placements": [],
      "expected": { "scenes": [], "total_frames": 0 }
    }
  ]
}
